# =================================================================
# HiddenGemsAI Environment Variables Configuration Template
# =================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit real secrets or production credentials to git.
#
# Steps:
#   1. Copy: cp .env.example .env  (or copy-item .env.example .env on Windows)
#   2. Fill in MONGODB_URI, JWT_SECRET, and any SMTP fields you need.
#   3. Run: npm install && npm run dev

# -----------------------------------------------------------------
# Server
# -----------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------
# Database  (REQUIRED)
# MongoDB Atlas URI — get this from cloud.mongodb.com → Connect → Drivers
# Also whitelist your IP in Atlas → Network Access before starting.
# -----------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=<appName>

# -----------------------------------------------------------------
# Authentication  (REQUIRED)
# Generate a strong secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be 32+ characters in production.
# -----------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# -----------------------------------------------------------------
# CORS
# In development this matches APP_BASE_URL. In production set to your public domain.
# -----------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------
# Request size limit (bytes) — 1 MB default
# -----------------------------------------------------------------
MAX_CONTENT_LENGTH=1048576

# -----------------------------------------------------------------
# Email / SMTP  (OPTIONAL in development)
# If SMTP_HOST/USER/PASS are omitted or left as placeholders, the server
# falls back to printing verification links in the console (dev mode only).
# -----------------------------------------------------------------
EMAIL_FROM=HiddenGemsAI <noreply@hiddengemsai.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
SMTP_SECURE=false

# -----------------------------------------------------------------
# Python ML Recommendation Service
# The Flask service runs separately on port 5000.
# Use FLASK_PORT to set the Flask port (must NOT match NODE PORT above).
# -----------------------------------------------------------------
PYTHON_EXECUTABLE=python
PYTHON_SERVICE_URL=http://127.0.0.1:5000
FLASK_PORT=5000
PYTHON_HOST=127.0.0.1
PYTHON_SERVICE_TIMEOUT_MS=8000
# Set to true to skip auto-spawning Python worker (e.g. in CI or production)
DISABLE_PYTHON_SPAWN=false

# -----------------------------------------------------------------
# Rate Limiting (milliseconds per window)
# -----------------------------------------------------------------
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=15
RATE_LIMIT_VERIFY_WINDOW_MS=900000
RATE_LIMIT_VERIFY_MAX=5
RATE_LIMIT_RECOMMENDATION_WINDOW_MS=900000
RATE_LIMIT_RECOMMENDATION_MAX=30
RATE_LIMIT_WEATHER_WINDOW_MS=900000
RATE_LIMIT_WEATHER_MAX=30
