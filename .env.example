
# Server Port and Environment
PORT=your_value_here
NODE_ENV=your_value_here
APP_BASE_URL=your_value_here

# Database Connection
# MongoDB Atlas or local MongoDB connection URI string
MONGODB_URI=your_value_here

# JSON Web Token Secret
# Secret key used to sign and verify JWT authentication tokens
# IMPORTANT: Replace with a strong random secret (minimum 32 characters) before production use
JWT_SECRET=your_value_here

# Production Email Verification & SMTP Service Configuration
# If SMTP credentials are provided, verification emails are sent via SMTP.
# If omitted in development mode, verification links are output to dev console.
EMAIL_FROM=your_value_here
SMTP_HOST=your_value_here
SMTP_PORT=your_value_here
SMTP_USER=your_value_here
SMTP_PASS=your_value_here
SMTP_SECURE=your_value_here

# Python Recommendation ML Service
# Path to python executable (e.g., python, python3, py)
PYTHON_EXECUTABLE=your_value_here
# URL where Python Flask recommendation worker is running
PYTHON_SERVICE_URL=your_value_here
# Port for the Flask Python service (must NOT match NODE PORT above)
FLASK_PORT=your_value_here
# Internal loopback host binding (prevents public internet exposure)
PYTHON_HOST=your_value_here
# Timeout for requests to the Python service in milliseconds
PYTHON_SERVICE_TIMEOUT_MS=your_value_here
# Set to true to disable automatic Python worker spawn (useful in CI or production)
DISABLE_PYTHON_SPAWN=your_value_here

# Maximum request body size limit in bytes (default: 1 MB =your_value_here
MAX_CONTENT_LENGTH=your_value_here

# CORS / browser security
# For same-origin deployment set this to the public app URL.
CORS_ORIGIN=your_value_here

# Rate Limiting Configuration (Authentication Protection)
# Window durations in milliseconds (default: 15 minutes =your_value_here
RATE_LIMIT_LOGIN_WINDOW_MS=your_value_here
RATE_LIMIT_LOGIN_MAX=your_value_here

RATE_LIMIT_REGISTER_WINDOW_MS=your_value_here
RATE_LIMIT_REGISTER_MAX=your_value_here

RATE_LIMIT_VERIFY_WINDOW_MS=your_value_here
RATE_LIMIT_VERIFY_MAX=your_value_here

# Additional API rate limits
RATE_LIMIT_RECOMMENDATION_WINDOW_MS=your_value_here
RATE_LIMIT_RECOMMENDATION_MAX=your_value_here
RATE_LIMIT_WEATHER_WINDOW_MS=your_value_here
RATE_LIMIT_WEATHER_MAX=your_value_here

# Nugen Intelligence Configuration
NUGEN_API_KEY=your_nugen_api_key_here
